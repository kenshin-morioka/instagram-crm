{
  "$schema": "gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウの既定権限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "dialog:allow-confirm",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/kenshin-morioka/instagram-crm/*" },
        { "url": "https://kenshin-morioka.github.io/instagram-crm/*" }
      ]
    }
  ]
}
