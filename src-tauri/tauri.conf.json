{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Instagram CRM",
  "version": "1.1.0",
  "identifier": "com.kenshinmorioka.instagram-crm",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Instagram CRM",
        "width": 480,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kenshin-morioka/instagram-crm/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBNjZCNURGQUU2MzMyNjIKUldSaU1tT3UzN1ZtR2plajBoZlZXTVpYYWhMYm9UaUI4VHUyR2YyQUV4VzhpV25pT1dDamN3YmIK"
    }
  }
}
